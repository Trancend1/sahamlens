# SahamLens environment template.
# Copy ke `.env.local` dan isi nilai. JANGAN commit `.env.local`.

# --- LLM provider ---
# Provider selection: "anthropic" (default), "openai_compatible", "openai",
# "deepseek", "openrouter", "tokenrouter", or "custom".
# Untuk Anthropic: cukup set ANTHROPIC_API_KEY.
# Untuk lainnya: set SAHAMLENS_LLM_BASE_URL + SAHAMLENS_LLM_API_KEY + SAHAMLENS_LLM_MODEL.
SAHAMLENS_LLM_PROVIDER=openrouter
SAHAMLENS_LLM_BASE_URL=https://openrouter.ai/api/v1
SAHAMLENS_LLM_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxx
SAHAMLENS_LLM_MODEL=anthropic/claude-sonnet-4-6

# --- Anthropic-specific (hanya dipakai jika SAHAMLENS_LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# --- Cost budget (baca dari config/cost_budget.yml, bukan env) ---
# Edit config/cost_budget.yml atau config/cost_budget.example.yml untuk atur daily cap.
# LLM_DAILY_COST_CAP_IDR sudah tidak dipakai — hapus dari .env.local jika ada.

# --- DuckDB path (default lokal, GITIGNORED) ---
DUCKDB_PATH=./data/private/sahamlens.duckdb

# --- Telegram optional delivery (V1-S6, disabled when empty) ---
SAHAMLENS_TELEGRAM_BOT_TOKEN=
SAHAMLENS_TELEGRAM_CHAT_ID=

# --- Next.js public ---
NEXT_PUBLIC_APP_NAME=SahamLens
NEXT_PUBLIC_DISCLAIMER_SHORT=Personal learning tool. Bukan investment advice.
