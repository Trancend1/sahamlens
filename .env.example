# SahamLens environment template.
# Copy ke `.env.local` dan isi nilai. JANGAN commit `.env.local`.

# --- LLM provider (Anthropic default per ADR-0005) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
LLM_PROVIDER=anthropic
LLM_DEFAULT_MODEL=claude-sonnet-4-6

# --- LLM cost cap (Rupiah per hari, soft limit) ---
LLM_DAILY_COST_CAP_IDR=15000

# --- DuckDB path (default lokal, GITIGNORED) ---
DUCKDB_PATH=./data/private/sahamlens.duckdb

# --- Telegram (opsional, V1) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Next.js public ---
NEXT_PUBLIC_APP_NAME=SahamLens
NEXT_PUBLIC_DISCLAIMER_SHORT=Personal learning tool. Bukan investment advice.
